# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

# Rust
[*.rs]
indent_size = 4

# Web / config / scripts
[*.{ts,tsx,js,jsx,mjs,cjs,json,css,html,ps1,psm1,yml,yaml,toml}]
indent_size = 2
tab_width = 2

[*.md]
indent_size = 2
tab_width = 2
max_line_length = off
trim_trailing_whitespace = false
